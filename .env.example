# MatchMates Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Optional - falls back to built-in in-memory database if empty or unavailable)
MONGODB_URI=mongodb://localhost:27017/chittilu

# Game Defaults
DEFAULT_MAX_PLAYERS=8
DEFAULT_ROUND_TIME_LIMIT=45
MIN_PLAYERS_TO_START=2
